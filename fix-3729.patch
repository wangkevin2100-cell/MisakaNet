set -euo pipefail

REPO="${REPO:-Ikalus1988/MisakaNet}"
BASE="${MISAKANET_BASE:-https://misakanet.org}"      # must be misakanet.org per AC-0
Q1="Supercharge from Setapp remains running but does not recreate"
Q2="SkyComputerUseService crash diagnostic step at a n"

# ---------------------------------------------------------------------------
# 1. Reproducible evidence against the production retrieval path.
#    Prints the exact command + raw output so the AC-0 box can be pasted verbatim.
# ---------------------------------------------------------------------------
evidence() {
  echo "=== RETRIEVAL EVIDENCE (AC-0) ==="
  echo "\$ MCP endpoint: ${BASE}/mcp   (misakanet_search)"
  echo

  for q in "$Q1" "$Q2"; do
    echo "\$ misakanet search --json \"$q\""
    # Prefer the local CLI (talk to production via --base); fall back to raw MCP over curl.
    if command -v misakanet >/dev/null 2>&1; then
      misakanet search --json --base "$BASE" "$q" 2>&1 || true
    else
      curl -sS -X POST "${BASE}/mcp" \
        -H 'content-type: application/json' \
        -d "$(printf '{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"misakanet_search","arguments":{"query":%s}}}' \
              "$(printf '%s' "$q" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read().strip()))')")" \
        2>&1 || true
    fi
    echo
  done
  echo "=== END RETRIEVAL EVIDENCE ==="
}

